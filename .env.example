POSTGRES_PASSWORD=replace_with_random_alphanumeric_password
DATABASE_URL=postgresql+psycopg://monitor:replace_with_random_alphanumeric_password@db:5432/monitor
API_KEY=replace_with_random_api_key
CSV_PATH=/data/readings.csv
API_PORT=8000

# Generar con python scripts/setup_mqtt.py --host IP_LAN --device UM1
# Puerto LAN sin TLS: no publicar esta configuracion directamente en Internet.
MQTT_PORT=1883
MQTT_WORKER_USERNAME=rutasalud-worker
MQTT_WORKER_PASSWORD=replace_with_random_worker_password
MQTT_DEVICE_CODE=UM1
MQTT_DEVICE_USERNAME=device-UM1
MQTT_DEVICE_PASSWORD=replace_with_different_random_device_password
